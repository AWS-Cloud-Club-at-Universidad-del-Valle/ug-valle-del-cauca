<!-- prettier-ignore -->
<script is:inline>
(() => {
if(matchMedia("(prefers-reduced-motion:reduce)").matches||location.hash)return;
try {
  if(sessionStorage.intro)return;
  const body=document.body;
  const a=document.querySelector(".barra .marca img").getBoundingClientRect();
  const b=document.querySelector(".intro-trazo").getBoundingClientRect();
  body.style.setProperty("--vuelo",`translate(${a.x-b.x+(a.width-b.width)/2}px,${a.y-b.y+(a.height-b.height)/2}px) scale(${a.width/b.width})`);
  sessionStorage.intro=1;
  body.classList.add("intro-activa");
  const control=new AbortController();
  const fin=()=>{
    body.classList.replace("intro-activa","intro-lista");
    control.abort();
  };
  setTimeout(fin,2350);
  for(const tipo of ["scroll","pointerdown","keydown","resize"])
    addEventListener(tipo,fin,{passive:true,signal:control.signal});
}catch{return}
})();
</script>
