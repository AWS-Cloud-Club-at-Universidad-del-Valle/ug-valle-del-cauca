---
import Enlace from "./Enlace.astro";
import IconoRed from "./IconoRed.astro";

interface Props {
  href: string;
  etiqueta: string;
  marca: "meetup" | "instagram";
  principal?: boolean;
  secundario?: boolean;
}

const { href, etiqueta, marca, principal, secundario } = Astro.props;
---

<Enlace
  class:list={["boton", secundario && "boton-secundario"]}
  href={href}
  data-testid={principal ? "cta-principal" : undefined}
>
  {etiqueta}
  <IconoRed {marca} />
</Enlace>
