---
interface Props {
  href: string;
  etiqueta: string;
  principal?: boolean;
}

const { href, etiqueta, principal } = Astro.props;
---

<a
  class="boton"
  href={href}
  data-testid={principal ? "cta-principal" : undefined}
>
  {etiqueta}
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path
      d="M4 12h15m-6-6 6 6-6 6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</a>
