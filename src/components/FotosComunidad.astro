---
const fotos = [
  {
    archivo: "grupo",
    alto: 506,
    alt: "Asistentes reunidos para una foto grupal frente a la Universidad Nacional.",
  },
  {
    archivo: "auditorio",
    alto: 675,
    alt: "Público sentado a ambos lados del pasillo central del auditorio.",
  },
  {
    archivo: "charla",
    alto: 675,
    alt: "Ponente con micrófono en el atril junto a una pantalla de proyección.",
  },
  {
    archivo: "taller",
    alto: 675,
    alt: "Participantes de un taller frente a sus monitores en el laboratorio.",
  },
  {
    archivo: "conversacion",
    alto: 675,
    alt: "Asistentes con escarapelas conversan de pie durante el encuentro.",
  },
  {
    archivo: "panel",
    alto: 675,
    alt: "Panelistas con micrófonos sentados en una mesa frente al público.",
  },
];
---

<figure class="fotos-comunidad">
  <ul class="mosaico-comunidad" role="list">
    {fotos.map(({ archivo, alto, alt }) => (
      <li>
        <img
          src={`/img/eventos/comunidad/${archivo}.webp`}
          alt={alt}
          width="900"
          height={alto}
          loading="lazy"
          decoding="async"
        />
      </li>
    ))}
  </ul>
  <figcaption>
    AWS Community Day Colombia 2026 · Bogotá.
    <a href="https://grp.team/aws-community-day-colombia-2026">
      Fotos de Germán Ruiz
    </a>
  </figcaption>
</figure>
