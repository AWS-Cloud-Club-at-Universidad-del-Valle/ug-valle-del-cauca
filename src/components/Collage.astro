<!-- prettier-ignore -->
<script is:inline>
(() => {
  const h = document.querySelector(".hero");
  const media = matchMedia("(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
  if(!h||!media.matches||!self.IntersectionObserver) return;
  const buscar = selector => h.querySelector(selector);
  const sol=buscar(".sol-papel"), notas=buscar(".firma-cielo"), pausa=buscar("#pausa-arte");
  const nombres = ["mx","my","ox","oy","nx","ny"];
  let visible = false, sucio = true, frame = 0, x, y, rect, sr, nr;
  const centro = r => [x-r.left-r.width/2,y-r.top-r.height/2];
  function parar() {
    cancelAnimationFrame(frame);
    frame = 0;
    for (const n of nombres) h.style.removeProperty("--"+n);
  }
  function pintar() {
    frame = 0;
    if (sucio) {
      rect = h.getBoundingClientRect();
      sr = sol.getBoundingClientRect();
      nr = notas.getBoundingClientRect();
      sucio = false;
    }
    const [hx,hy] = centro(rect), [sx,sy] = centro(sr);
    const [nx,ny] = centro(nr);
    const ojo = Math.max(28,Math.hypot(sx,sy));
    const d = Math.max(1,Math.hypot(nx,ny)), rep = Math.max(0,1-d/180)/d;
    const valores = [hx*2/rect.width,hy*2/rect.height,sx/ojo,sy/ojo,-nx*rep,-ny*rep];
    nombres.forEach((n,i) => h.style.setProperty("--"+n,Math.max(-1,Math.min(1,valores[i]))));
  }
  h.classList.add("hero-puntero");
  new IntersectionObserver(([entrada]) => {
    visible = entrada.isIntersecting;
    sucio = true;
    h.classList.toggle("hero-fuera", !visible);
    if (!visible) parar();
  }).observe(h);
  h.addEventListener("pointermove", e => {
    if (!visible || !media.matches || pausa.checked || e.pointerType==="touch") return;
    x = e.clientX;
    y = e.clientY;
    if (!frame) frame = requestAnimationFrame(pintar);
  }, {passive:true});
  h.addEventListener("pointerleave", parar);
  pausa.addEventListener("change", parar);
  media.addEventListener("change", parar);
  for (const tipo of ["scroll","resize"]) addEventListener(tipo,()=>{sucio=true},{passive:true});
})();
</script>
