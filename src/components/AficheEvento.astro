---
import type { Evento } from "../content/esquemas";

interface Props {
  evento: Evento;
}

const { evento } = Astro.props;
---

{evento.imagen && (
  <img
    class="afiche-evento"
    src={evento.imagen}
    alt={evento.imagen_alt ?? `Afiche de ${evento.titulo}`}
    width="800"
    height="450"
    loading="lazy"
    decoding="async"
  />
)}
