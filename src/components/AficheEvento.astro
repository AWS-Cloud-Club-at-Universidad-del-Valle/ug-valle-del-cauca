---
import type { Evento } from "../content/esquemas";

interface Props {
  evento: Evento;
  reservarEspacio?: boolean;
}

const { evento, reservarEspacio } = Astro.props;
---

{evento.imagen ? (
  <img
    class="afiche-evento"
    src={evento.imagen}
    alt={evento.imagen_alt ?? `Afiche de ${evento.titulo}`}
    width="800"
    height="450"
    loading="lazy"
    decoding="async"
  />
) : (
  reservarEspacio && (
    <span class="afiche-evento afiche-vacio" aria-hidden="true" />
  )
)}
