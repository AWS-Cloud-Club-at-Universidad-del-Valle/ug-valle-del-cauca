      ))}
    </g>
    <g color="var(--hoja)">
      <use
        href="#cana-papel"
        transform="translate(145 330) rotate(-11) scale(.59)"
      />
      <use
        href="#cana-papel"
        transform="translate(186 330) rotate(13) scale(.65)"
      />
      <use
        href="#cana-papel"
        transform="translate(1279 330) rotate(-14) scale(.73)"
      />
      <use
        href="#cana-papel"
        transform="translate(1330 330) rotate(16) scale(.61)"
      />
    </g>
  </svg>
)}
{lugar === "guayacanes" && (
  <svg class="arte arte-guayacanes" aria-hidden="true" viewBox="0 0 1440 480">
    {["oro", "rosa"].map((color, i) => (
      <g
        transform={i ? "translate(1440 17) scale(-1 1)" : undefined}
        class:list={["ramo", color]}
      >
        <path
          d="M-30 76q154 20 280 64 143 50 280 112-96-33-211-62l-25 39-9-4 18-40q-72-22-132-30l-34 67-13-5 27-67q-90-18-181-19Z"
          fill="var(--tronco)"
        />
        <path
          d="M1 144q138 1 236 69l-2 9Q106 168 0 175Z"
          fill="var(--tronco)"
        />
        <g class="ramo-mueve fibra-local">
          <path
            d="M-24 31C45-7 105 16 132 43c47-14 133 6 145 66 50-3 97 36 109 61 57 8 71 32 84 50-84 4-151-23-218-62C103 100 43 157-22 112Z"
            fill="currentColor"
          />
          {flores.map(([x, y, s]) => (
            <use
              href="#flor-papel"
              transform={`translate(${x} ${y}) scale(${s})`}
            />
          ))}
        </g>
        <g fill="currentColor" opacity=".8">
          <path d="M104 280q-23-4-13 10 9 7 13-10Zm115 22q-28 2-10 15 9 5 10-15Zm145 34q-23-6-15 7 7 12 15-7Z" />
        </g>
      </g>
    ))}
  </svg>
)}
{lugar === "pacifico" && (
  <>
    <svg
      class="arte bruma-pacifico"
      aria-hidden="true"
      viewBox="0 0 1440 310"
      preserveAspectRatio="xMidYMin slice"
    >
      <g fill="var(--noche-clara)">
        <path d="M0 72q75-24 165-13 77 10 170 0-94 34-208 26Q55 80 0 102Zm1059 145q167-55 381-40v23q-177-14-381 17Z" />
        <path d="M1049 75q80-52 231-41l160-8v20l-164 15q-113-12-227 14Z" />
      </g>
      <g color="var(--lavanda)" opacity=".6">
        <use href="#destello-papel" x="220" y="100" />
        <use href="#destello-papel" x="1209" y="115" />
        <use href="#destello-papel" x="1280" y="66" />
      </g>
    </svg>
    <svg class="arte arte-pacifico" aria-hidden="true" viewBox="0 0 1440 390">
      <path
        fill="var(--calima-loma)"
        d="M0 142 92 102l81 20 49-33 52 35 87 11 47 35 76 8 86 37 150 12 94-28 70 3 90-38 110 8 79-44 85-1 102-37 90 31v269H0Z"
