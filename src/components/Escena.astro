        <circle cx="78" cy="-2" r="9" fill="var(--noche)" />
      </g>
    </defs>
    <g transform="translate(626 182)">
      <g class="tren-pasa">
        <use href="#vagon-cana" />
        <use href="#vagon-cana" x="113" />
        <use href="#vagon-cana" x="226" />
        <g transform="translate(345)">
          <path d="M-5-51h55v20h41l21 23H-5Z" fill="var(--noche)" />
          <path d="M10-41h23v15H10Z" fill="var(--miel)" />
          <path d="M72-53h14v29H72ZM-10-55h65v8h-65Z" fill="var(--loma)" />
          <path
            d="m82-62q-16-6-9-15 5-6 15 0 3-13 14-6 13 11-20 21Z"
            fill="var(--hoja)"
          />
          <circle
            cx="17"
            cy="-2"
            r="12"
            fill="var(--sol)"
            stroke="var(--noche)"
            stroke-width="5"
          />
          <circle
            cx="57"
            cy="-2"
            r="12"
            fill="var(--sol)"
            stroke="var(--noche)"
            stroke-width="5"
          />
          <circle cx="91" cy="-3" r="8" fill="var(--noche)" />
