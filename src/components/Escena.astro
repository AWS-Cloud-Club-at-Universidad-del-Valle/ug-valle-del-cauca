---
interface Props {
  lugar: "cali" | "calima" | "tren" | "guayacanes" | "pacifico" | "cordillera";
}
const { lugar } = Astro.props;

const luces = Array.from({ length: 19 }, (_, i) => {
  const x = i * 80;
  return { x, y: 35 + 300 * (x / 1440) * (1 - x / 1440) };
});
const estrellas = [
  [94, 169],
  [193, 237],
  [309, 183],
  [1101, 140],
  [1207, 230],
  [1321, 175],
  [1399, 282],
];
const flores = [
  [35, 43, 1.4],
  [88, 100, 1.19],
  [139, 60, 1.54],
  [204, 125, 1.48],
  [237, 74, 1],
  [277, 155, 1.6],
  [325, 113, 1.1],
  [329, 204, 1.22],
  [373, 178, 0.91],
  [408, 200, 1.3],
  [451, 233, 0.88],
  [494, 251, 1.04],
];
---

{lugar === "cali" && (
  <>
    <svg class="arte arte-cali" aria-hidden="true" viewBox="0 0 1440 405">
      <path
        d="M0 35Q720 185 1440 35"
        fill="none"
        stroke="var(--lavanda)"
        stroke-width="1.5"
      />
      {luces.map(({ x, y }, i) => (
        <g transform={`translate(${x} ${y})`}>
          <path d="M0 0v16" stroke="var(--lavanda)" stroke-width="1.5" />
          <path
            d="M-5 15H5v5q8 12-5 16-13-4-5-16Z"
            fill={i % 3 === 0 ? "var(--durazno)" : "var(--miel)"}
          />
        </g>
      ))}
      {estrellas.map(([x, y], i) => (
        <g transform={`translate(${x} ${y})`} color="var(--violeta)">
          <use
            href="#destello-papel"
            class="titila"
            style={`--fase: -${i * 0.63}s`}
          />
        </g>
      ))}
      <path
        id="edificios-cali"
        class="fibra-local"
        d="M0 405V281h29v-27h44v31h33v39h21v-13h42v26h37v-66h25v-18h22v18h28v90h39v-27h51v26h37v45ZM1440 405V260h-43v28h-41v55h-34v-67h-25v-28h-38v89h-31v28h-24v-42h-41v33h-59v20h-38v29Z"
        fill="var(--noche-clara)"
      />
      <g color="var(--lavanda)">
        <g transform="translate(147 248) rotate(-17) scale(1.5)">
          <use class="nota-flota" href="#nota-papel" />
        </g>
        <g transform="translate(1259 238) rotate(11) scale(1.8)">
          <use class="nota-flota nota-dos" href="#nota-papel" />
        </g>
      </g>
      <g fill="var(--miel)" opacity=".65">
        <path d="M36 296h7v6h-7zm18 0h7v6h-7zm172 21h7v6h-7zm19 0h7v6h-7zm-19 19h7v6h-7zm1030-33h7v6h-7zm17 0h7v6h-7zm124 23h7v6h-7zm17 0h7v6h-7z" />
      </g>
    </svg>
    <svg
      class="arte cali-ciudad"
      aria-hidden="true"
      viewBox="0 245 1440 160"
      preserveAspectRatio="none"
    >
      <use href="#edificios-cali" />
      <g color="var(--violeta)">
        <use href="#destello-papel" x="152" y="282" />
        <use href="#destello-papel" x="1290" y="285" />
      </g>
    </svg>
  </>
)}
{lugar === "calima" && (
  <>
    <svg class="arte calma-viento" viewBox="0 0 450 175" aria-hidden="true">
      <path
        d="M26 106q84-38 184-26t184-15M84 125q110-39 196-21 74 16 147-14"
