    <svg class="arte arte-calima" aria-hidden="true" viewBox="0 0 1440 505">
      <path
        fill="var(--calima-aire)"
        d="M0 73C184 31 333 53 521 81c284 43 509-20 919-24v448H0Z"
      />
      <path
