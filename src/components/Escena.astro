      >
        <path d="M505 293q55 13 103 5t90 0 101-7 88-8M593 310q52 5 105 0t104-4m29-3 34-5M104 265q87-14 194 3m22 2 52 7m640-16q110-20 239-8m17 2 58 3M173 351q110-13 206 4m609-22q170-30 287-27" />
        <path d="M626 276q-10-19-20-21m36 13q-3-18-11-27m160 35q11-18 22-22m-36 16q3-15 10-23" />
      </g>
    </svg>
  </>
)}
