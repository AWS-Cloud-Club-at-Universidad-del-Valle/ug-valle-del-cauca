    </g>
    <g color="var(--calima-lejos)" opacity=".85">
      {[83, 248, 431, 605, 810, 980, 1180, 1390].map((x, i) => (
        <use
          href="#cana-papel"
          transform={`translate(${x} ${310 + (i % 3) * 7}) rotate(${i % 2 ? 14 : -12}) scale(${0.12 + (i % 3) * 0.055})`}
