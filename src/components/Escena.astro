      <g transform="translate(895 333)">
        <g class="vela-calima">
          <path d="M-57 1 64-3 46 11-42 15Z" fill="var(--noche)" />
          <path d="m3-108 47 101-46-7Z" fill="var(--hoja)" />
          <path d="m-4-94-47 86 45-6Z" fill="var(--durazno)" />
          <path d="M0-115v116" stroke="var(--noche)" stroke-width="3" />
          <path
            d="M-74 22q26-11 61-2m-32 11 52-2"
            fill="none"
            stroke="var(--onda)"
            stroke-width="3"
          />
        </g>
      </g>
      <g transform="translate(1252 405)">
        <g class="tabla-calima">
          <path d="M-33 1q22-7 66 0L18 7h-40Z" fill="var(--miel)" />
          <path d="M-5 1-17-74Q15-55 25-13Z" fill="var(--lavanda)" />
          <path
            d="M-17-74-5 1M-11-40l36 27"
            fill="none"
            stroke="var(--noche)"
            stroke-width="2"
          />
        </g>
      </g>
    </svg>
  </>
)}
{lugar === "tren" && (
