      <path
        class="fibra-local"
        fill="var(--rio)"
        d="M0 282c304-49 362 32 594 27 219-6 345-78 555-70 104 4 202 14 291 5v146H0Z"
      />
      <path
        fill="var(--noche-clara)"
        d="M0 352c277-45 454 18 772-17 249-27 425-64 668-42v97H0Z"
      />
      <g class="ballena" transform="translate(725 285)">
        <g class="cola">
          <path
            d="M-29 11Q-42-57-55-71c-26 4-64-17-81-61q61 33 106 25 30-28 101-42-11 40-39 55L10-84Q-2-52 17 11Z"
            fill="var(--noche)"
            stroke="var(--calima-aire)"
            stroke-width="2"
          />
          <path
            d="M-114-117q52 21 84 15 16-15 64-30-25 25-64 40-60-5-84-25Z"
            fill="var(--lavanda)"
          />
        </g>
      </g>
      <g
        fill="none"
