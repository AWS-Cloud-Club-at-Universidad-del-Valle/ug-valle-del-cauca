---
import IconoRed from "../components/IconoRed.astro";
import Enlace from "../components/Enlace.astro";
import { getCollection, getEntry, render } from "astro:content";
import Logo from "../components/Logo.astro";
import BotonCta from "../components/BotonCta.astro";
import Collage from "../components/Collage.astro";
import IntroMarca from "../components/IntroMarca.astro";
import MejoraPortada from "../components/MejoraPortada.astro";
import AficheEvento from "../components/AficheEvento.astro";
import VitrinaMeetup from "../components/VitrinaMeetup.astro";
import Escena from "../components/Escena.astro";
import Sitio from "../layouts/Sitio.astro";
import { resolverCta } from "../lib/cta";
import { separarEventos } from "../lib/eventos";

const entrada = await getEntry("sitio", "inicio");
if (!entrada) throw new Error("Faltan los datos de src/content/sitio.yaml");

const sitio = entrada.data;
const cta = resolverCta(sitio);
const instagramSecundario =
  cta.destino === "meetup" ? sitio.instagram_url : undefined;
const grupo = await getEntry("grupoMeetup", "grupo");
const ahora = new Date();
const entradas = await getCollection("eventos");
const { proximos, pasados } = separarEventos(
  entradas.map(({ data }) => data),
  ahora,
);
const destacado = entradas.find(
  ({ data }) => data.destacado && pasados.includes(data),
);
const fichaDestacada = destacado && (await render(destacado));
const organizadores = (await getCollection("organizadores"))
  .map(({ data }) => data)
  .sort((a, b) => a.orden - b.orden);
function iniciales(nombre: string) {
  const partes = nombre.split(/\s+/);
  return [partes[0], partes.length > 1 ? partes.at(-1) : undefined]
    .map((parte) => Array.from(parte ?? "")[0] ?? "")
    .join("")
    .toLocaleUpperCase("es-CO");
}

const fechaEnBogota = new Intl.DateTimeFormat("es-CO", {
  dateStyle: "long",
  timeZone: "America/Bogota",
});
const fechaYHoraEnBogota = new Intl.DateTimeFormat("es-CO", {
  dateStyle: "long",
  timeStyle: "short",
  timeZone: "America/Bogota",
});
const proximo = proximos[0];
const region = "Valle del Cauca";
const tieneRegion = sitio.nombre.endsWith(` ${region}`);
const nombreGrupo = tieneRegion
  ? sitio.nombre.slice(0, -region.length - 1)
  : sitio.nombre;
const modalidades = {
  presencial: "Presencial",
  virtual: "Virtual",
  hibrido: "Híbrido",
};
const secciones = [
  { id: "comunidad", etiqueta: "Comunidad" },
  { id: "eventos", etiqueta: "Eventos" },
  { id: "historia", etiqueta: "Trayectoria" },
];
const redes = [
  { nombre: "LinkedIn", url: sitio.linkedin_url },
  ...sitio.otras_redes,
];
---

<Sitio titulo={sitio.nombre} descripcion={sitio.descripcion} portada>
  <header class="barra">
    <Logo />
    <nav class="nav-amplia" aria-label="Navegación principal">
      {secciones.map(({ id, etiqueta }) => (
        <a href={`#${id}`}>{etiqueta}</a>
      ))}
    </nav>
    <details class="menu">
      <summary>Menú</summary>
      <nav aria-label="Navegación principal">
        {secciones.map(({ id, etiqueta }) => (
          <a href={`#${id}`}>{etiqueta}</a>
        ))}
      </nav>
    </details>
    <div class="barra-redes">
      <BotonCta href={cta.url} etiqueta={cta.etiqueta} marca={cta.destino} />
      {instagramSecundario && (
        <Enlace class="enlace-red" href={instagramSecundario}>
          <IconoRed marca="instagram" />
          Instagram
        </Enlace>
      )}
    </div>
  </header>
  <main id="contenido">
    <IntroMarca />
    <div class="hero">
      <section class="hero-texto" aria-labelledby="titulo">
        <p class="rotulo enter">Comunidad AWS · Cali, Colombia</p>
        <h1 id="titulo">
          <span class="mascara">
            <span class="enter">{nombreGrupo}</span>
          </span>
          {tieneRegion && (
            <span class="mascara mascara-region">
              <span class="enter">{region}</span>
            </span>
          )}
        </h1>
        <p class="bajada enter">{sitio.descripcion}</p>
        <div class="acciones enter">
          <BotonCta
            href={cta.url}
            etiqueta={cta.etiqueta}
            marca={cta.destino}
            principal
          />
          {instagramSecundario && (
            <Enlace class="enlace-red" href={instagramSecundario}>
              <IconoRed marca="instagram" />
              Síguenos en Instagram
            </Enlace>
          )}
          <a href="#eventos">Ver próximos eventos</a>
        </div>
        {proximo && (
          <p class="adelanto">
            <a href="#eventos">Próximo encuentro: {proximo.titulo}</a>
            <span>
              <time datetime={proximo.fecha.toISOString()}>
                {fechaEnBogota.format(proximo.fecha)}
              </time>{" "}
              · {proximo.lugar}
            </span>
          </p>
        )}
      </section>
      <Collage />
    </div>

    <section class="escena escena-cali" aria-labelledby="comunidad">
      <div class="contenedor escena-texto">
        <h2 id="comunidad">Qué es el UG</h2>
        <div>
          <p>
            Somos una comunidad de profesionales de tecnología del Valle del
            Cauca que se reúne para aprender y compartir sobre AWS.
          </p>
          <ul class="pentagrama" aria-label="En nuestros encuentros">
            {[
              "Charlas técnicas",
              "Talleres prácticos",
              "Conexiones en comunidad",
            ].map((actividad, i) => (
              <li>
                <svg
                  viewBox="-22 -55 60 72"
                  width="46"
                  height="54"
                  aria-hidden="true"
                >
                  <use
                    href="#nota-papel"
                    class:list={["nota-flota", i === 1 && "nota-dos"]}
                  />
                </svg>
                <span>{actividad}</span>
              </li>
            ))}
          </ul>
          <p>
            Si eres estudiante, conoce el{" "}
            <Enlace data-testid="enlace-sbg" href={sitio.sbg_url}>
              AWS Student Builder Group
            </Enlace>
            .
          </p>
        </div>
      </div>
      <Escena lugar="cali" />
    </section>

    <VitrinaMeetup
      {proximos}
      {pasados}
      {ahora}
      {modalidades}
      grupo={grupo?.data}
      meetup={sitio.meetup_url}
      {cta}
    />

    <section
      class="escena escena-tren"
      aria-labelledby="historia"
      style={`--tiquetes: ${pasados.length}`}
    >
      <div class="anden">
        <div class="contenedor escena-texto">
          <h2 id="historia">Lo que hemos hecho</h2>
          {pasados.length > 0 && (
            <div
              class="ventana-via"
              role="region"
              aria-label="Tiquetes de eventos pasados"
              tabindex="0"
            >
              <ol class="listado via">
                {pasados.map((evento) => (
                  <li
                    class:list={[
                      "tiquete",
                      evento === destacado?.data && "destacado",
                    ]}
                  >
                    <time datetime={evento.fecha.toISOString()}>
                      {evento === destacado?.data
                        ? fechaYHoraEnBogota.format(evento.fecha)
                        : fechaEnBogota.format(evento.fecha)}
                    </time>
                    <h3>
                      {evento.url_registro ? (
                        <Enlace href={evento.url_registro}>
                          {evento.titulo}
                        </Enlace>
                      ) : (
                        evento.titulo
                      )}
                    </h3>
                    <p>
                      {evento.lugar} · {modalidades[evento.modalidad]}
                    </p>
                    <AficheEvento evento={evento} reservarEspacio />
                    {evento.resumen &&
                      (evento.resumen.length > 320 ? (
                        <details class="descripcion-evento">
                          <summary>Descripción del encuentro</summary>
                          <p>{evento.resumen}</p>
                        </details>
                      ) : (
                        <p class="resumen-tiquete">{evento.resumen}</p>
                      ))}
                    {evento === destacado?.data && fichaDestacada && (
                      <details class="agenda-destacada">
                        <summary>Agenda del encuentro</summary>
                        <fichaDestacada.Content />
                        {evento.url_agenda && (
                          <p>
                            <Enlace href={evento.url_agenda}>
                              Consulta la agenda oficial de {evento.titulo}
                            </Enlace>
                          </p>
                        )}
                      </details>
                    )}
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>
        <Escena lugar="tren" />
      </div>
    </section>

    <section class="escena escena-guayacanes" aria-labelledby="organizadores">
      <div class="contenedor escena-texto">
        <h2 id="organizadores">Organizadores</h2>
        {organizadores.length ? (
          <ul class="listado equipo">
            {organizadores.map((persona) => (
              <li>
                {persona.foto ? (
                  <img
                    class="retrato-organizador"
                    src={persona.foto}
                    alt={persona.foto_alt ?? `Retrato de ${persona.nombre}`}
                    width="320"
                    height="320"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span
                    class="retrato-organizador monograma-organizador"
                    aria-hidden="true"
                  >
                    {iniciales(persona.nombre)}
                  </span>
                )}
                <div>
                  <h3>{persona.nombre}</h3>
                  <p>{persona.rol}</p>
                  {persona.linkedin && (
                    <Enlace
                      class="enlace-linkedin"
                      href={persona.linkedin}
                      aria-label={`Perfil de ${persona.nombre} en LinkedIn`}
                    >
                      <svg
                        aria-hidden="true"
                        viewBox="0 0 24 24"
                        width="28"
                        height="28"
                      >
                        <path
                          fill="currentColor"
                          d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.064 2.064 0 1 1 0-4.128 2.064 2.064 0 0 1 0 4.128zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0z"
                        ></path>
                      </svg>
                    </Enlace>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p>Por ahora, puedes contactar al grupo a través de sus redes.</p>
        )}
      </div>
      <Escena lugar="guayacanes" />
    </section>

    <section class="escena escena-pacifico unirse" aria-labelledby="unirse">
      <div class="contenedor escena-texto">
        <h2 id="unirse">Cómo unirse</h2>
        <div>
          <p>Entérate de los próximos encuentros de la comunidad.</p>
          <div class="acciones acciones-unirse">
            <BotonCta
              href={cta.url}
              etiqueta={cta.etiqueta}
              marca={cta.destino}
            />
            {instagramSecundario && (
              <BotonCta
                href={instagramSecundario}
                etiqueta="Síguenos en Instagram"
                marca="instagram"
                secundario
              />
            )}
          </div>
          {redes.some(({ url }) => url) && (
            <ul class="redes">
              {redes.map(
                ({ nombre, url }) =>
                  url && (
                    <li>
                      <Enlace href={url}>{nombre}</Enlace>
                    </li>
                  ),
              )}
            </ul>
          )}
        </div>
      </div>
      <Escena lugar="pacifico" />
    </section>
  </main>
  <nav slot="redes-pie" class="redes-pie" aria-label="Redes del grupo">
    {sitio.meetup_url && (
      <Enlace class="enlace-red" href={sitio.meetup_url}>
        <IconoRed marca="meetup" />
        Meetup
      </Enlace>
    )}
    <Enlace class="enlace-red" href={sitio.instagram_url}>
      <IconoRed marca="instagram" />
      Instagram
    </Enlace>
  </nav>
  <MejoraPortada slot="mejora" />
</Sitio>
