---
import Sitio from "../layouts/Sitio.astro";
---

<Sitio
  titulo="Página no encontrada"
  descripcion="La página solicitada no está disponible."
>
  <main id="contenido" class="contenedor pagina-error">
    <p class="rotulo">Error 404</p>
    <h1>Página no encontrada</h1>
    <p>La página solicitada no está disponible.</p>
    <a class="boton" href="/">
      Volver al inicio
    </a>
  </main>
</Sitio>
