---
import Enlace from "../components/Enlace.astro";
import Logo from "../components/Logo.astro";
import Escena from "../components/Escena.astro";
import "../styles/sitio.css";

interface Props {
  titulo: string;
  descripcion: string;
  portada?: boolean;
}

const { titulo, descripcion, portada } = Astro.props;
const imagenSocial = Astro.site
  ? new URL("/og.png", Astro.site).href
  : "/og.png";
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <title>{titulo}</title>
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link
      rel="preload"
      href="/fonts/archivo-latin-800.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="salto" href="#contenido">
      Ir al contenido
    </a>
    {!portada && (
      <header class="contenedor cabecera-interna">
        <Logo />
      </header>
    )}
    <slot />
    <footer class:list={["pie", portada && "pie-cordillera"]}>
      {portada && <Escena lugar="cordillera" />}
      <div class="contenedor pie-interior">
        <Logo />
        <p>Comunidad independiente, parte del programa AWS User Groups.</p>
        <Enlace href="https://github.com/AWS-Cloud-Club-at-Universidad-del-Valle/ug-valle-del-cauca">
          Repositorio del sitio
        </Enlace>
        <slot name="redes-pie" />
        {portada && (
          <label class="control-movimiento">
            <input id="pausa-arte" type="checkbox" /> Pausar ilustraciones
          </label>
        )}
      </div>
    </footer>
    <slot name="mejora" />
  </body>
</html>
