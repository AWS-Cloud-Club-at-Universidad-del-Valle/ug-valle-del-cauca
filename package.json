{
  "name": "awsug-valle-del-cauca",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "revisar-ejemplo": "node scripts/revisar-ejemplo.mjs",
    "links": "linkinator '**/*.html' --server-root dist --recurse --check-fragments --skip '^https?://(?!127\\.0\\.0\\.1:[0-9]+/)'",
    "lighthouse": "lhci autorun",
    "verify": "pnpm check && pnpm lint && pnpm test && pnpm build && pnpm links && pnpm test:e2e && pnpm lighthouse"
  },
  "dependencies": {
    "astro": "7.4.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.1",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
